# NEVER commit your actual ".env" file to Git.
# ============================================================================

# --- Application & Domain Settings ---
APP_ENV=production
APP_DEBUG=false
SITE_URL=https://skycadigital.com
COMPANY_LEGAL_NAME="Skyca Digital Private Limited"
COMPANY_BRAND_NAME="Skyca Digital"
BUSINESS_EMAIL=info@skycadigital.com
BUSINESS_PHONE="+91 6002064873"
BUSINESS_PHONE_RAW="+916002064873"

# --- Optional Verified Company Information (Leave blank until verified) ---
COMPANY_ADDRESS=""
COMPANY_CITY=""
COMPANY_STATE=""
COMPANY_POSTAL_CODE=""
COMPANY_COUNTRY="IN"
COMPANY_CIN=""
COMPANY_GSTIN=""
COMPANY_WORKING_HOURS="Monday - Saturday, 9:30 AM - 6:30 PM IST"
WHATSAPP_NUMBER=""
CONSULTATION_BOOKING_URL=""
SOCIAL_LINKEDIN_URL=""
SOCIAL_GITHUB_URL=""
SOCIAL_X_URL=""
SOCIAL_FACEBOOK_URL=""
SOCIAL_INSTAGRAM_URL=""

# --- MySQL Database Configuration (Hostinger MySQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=u591469534_skyca
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_CHARSET=utf8mb4

# --- Admin Dashboard Configuration ---
# Set ADMIN_EMAIL and ADMIN_INITIAL_PASSWORD before first login or run:
# php database/setup_admin.php
ADMIN_EMAIL=info@skycadigital.com
ADMIN_INITIAL_PASSWORD=
SESSION_COOKIE_SECURE=true
IP_HASH_SALT=change_this_to_a_random_64_character_hex_string_in_production

# --- SMTP / Transactional Email Configuration ---
# Used to send lead alerts to info@skycadigital.com and optional client confirmations
SMTP_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=info@skycadigital.com
SMTP_PASSWORD=
MAIL_FROM=info@skycadigital.com
MAIL_FROM_NAME="Skyca Digital Private Limited"
ADMIN_NOTIFICATION_EMAIL=info@skycadigital.com
SEND_CLIENT_CONFIRMATION_EMAIL=true

# --- Analytics, Google Ads & Marketing Readiness ---
# Leave blank if not yet configured. Tracking loads strictly based on configuration & user consent.
GOOGLE_ANALYTICS_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
META_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=
